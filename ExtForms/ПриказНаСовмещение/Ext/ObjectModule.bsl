// Форматирует ФИО в вид "Фамилия И. О."
Функция ПолучитьФИОСИнициаламиПослеФамилии(Знач ФИО) Экспорт
    
    ФИО = СокрЛП(ФИО);
    Если ПустаяСтрока(ФИО) Тогда Возврат ""; КонецЕсли;
    
    Части = СтрРазделить(ФИО, " ", Ложь);
    
    // Если ФИО неполное (нет отчества), возвращаем как есть
    Если Части.Количество() < 3 Тогда 
        Возврат ФИО; 
    КонецЕсли;
    
    Фамилия = Части[0];
    Имя = Части[1];
    Отчество = Части[2];
    
    // Берем первые буквы имени и отчества, добавляем точки и пробел
    Инициалы = Лев(Имя, 1) + ". " + Лев(Отчество, 1) + ".";
    
    Возврат Фамилия + " " + Инициалы;
    
КонецФункции