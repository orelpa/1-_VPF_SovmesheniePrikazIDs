// ============================================================================
// РЕГИСТРАЦИЯ ВНЕШНЕЙ ОБРАБОТКИ
// ============================================================================

Функция СведенияОВнешнейОбработке() Экспорт 
	
    ПараметрыРегистрации = Новый Структура;
    МассивНазначений = Новый Массив;
    МассивНазначений.Добавить("Документ.Совмещение");
    
    ПараметрыРегистрации.Вставить("Вид","ПечатнаяФорма");
    ПараметрыРегистрации.Вставить("Назначение",МассивНазначений);
    ПараметрыРегистрации.Вставить("Наименование","Приказ и ДС о совмещении должностей с логотипом");
    ПараметрыРегистрации.Вставить("Версия","1.0");
    ПараметрыРегистрации.Вставить("БезопасныйРежим",Истина);
    ПараметрыРегистрации.Вставить("Информация","Приказ и ДС о совмещении должностей с логотипом");
    
    ТаблицаКоманд = ПолучитьТаблицуКоманд();
    
    // Первая команда - Приказ
    ДобавитьКоманду(ТаблицаКоманд, "Приказ о совмещении должностей", "ВПФ_MXL_ПраказНаСовмещениеДолжностей", "ВызовСерверногоМетода", Истина, "ПечатьMXL");
    
    ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
    
    Возврат ПараметрыРегистрации;
    
КонецФункции

Функция ПолучитьТаблицуКоманд()
    
    Команды = Новый ТаблицаЗначений;
    Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
    Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
    Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
    Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
    Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
    
    Возврат Команды; 
    
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
    
    НоваяКоманда = ТаблицаКоманд.Добавить();
    НоваяКоманда.Представление = Представление;
    НоваяКоманда.Идентификатор = Идентификатор;
    НоваяКоманда.Использование = Использование;
    НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
    НоваяКоманда.Модификатор = Модификатор;
    
КонецПроцедуры

// ============================================================================
// ПЕЧАТЬ
// ============================================================================

Процедура Печать(МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода, ПараметрыПечати = Неопределено) Экспорт
    
    ПараметрыПечати = Новый Структура;
    
    // Печать Приказа
    Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ВПФ_MXL_ПраказНаСовмещениеДолжностей") Тогда
        
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
            КоллекцияПечатныхФорм,
            "ВПФ_MXL_ПраказНаСовмещениеДолжностей",
            НСтр("ru = 'Приказ о совмещении должностей'; en = 'Order'"),
            СформироватьПриказ(МассивОбъектов[0], ОбъектыПечати, ПараметрыПечати));
            
    КонецЕсли;
    
КонецПроцедуры

// ============================================================================
// ФОРМИРОВАНИЕ ПРИКАЗА
// ============================================================================

Функция СформироватьПриказ(СсылкаНаОбъект, ОбъектыПечати, ПараметрыПечати) Экспорт   
    
    УстановитьПривилегированныйРежим(Истина);
    
    Документ = СсылкаНаОбъект.Ссылка;
    
    ТабДокумент = Новый ТабличныйДокумент;
    ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
    ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПриказНаСовмещение";
    ТабДокумент.ПолеСлева = 10;
    ТабДокумент.ПолеСправа = 10;
    ТабДокумент.ПолеСнизу = 10;
    ТабДокумент.ПолеСверху = 10;
    ТабДокумент.АвтоМасштаб = Истина;
    
    Макет = ПолучитьМакет("ВПФ_MXL_ПраказНаСовмещениеДолжностей");
    
    СсылкаНаСовмещающего = Документ.СовмещающийСотрудник;
    СсылкаНаОтсутствующего = Документ.ОтсутствующийСотрудник;
    
    // === 1. ФИО сотрудников ===
    ФИОСовмещающегоИсходное = СсылкаНаСовмещающего.Наименование;
    ФИООтсутствующегоИсходное = СсылкаНаОтсутствующего.Наименование;
    
    // Склоняем ФИО для разных падежей
    ФИООтсутствующего = СклонитьФИО(ФИООтсутствующегоИсходное, "Родительный"); // отсутствие кого?
    ФИОСовмещающего = СклонитьФИО(ФИОСовмещающегоИсходное, "Винительный");     // возложить на кого?
    ФИОСовмещающегоДательный = СклонитьФИО(ФИОСовмещающегоИсходное, "Дательный"); // установить кому?
    
    // === 2. Данные СОВМЕЩАЮЩЕГО сотрудника (должность, отдел) ===
    СотрудникОбъект = СсылкаНаСовмещающего.ПолучитьОбъект();
    ФизическоеЛицоСовмещающего = СотрудникОбъект.ФизическоеЛицо;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   КадроваяИсторияСотрудниковСрезПоследних.Должность КАК Должность,
        |   КадроваяИсторияСотрудниковСрезПоследних.Подразделение КАК Подразделение
        |ИЗ
        |   РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних КАК КадроваяИсторияСотрудниковСрезПоследних
        |ГДЕ
        |   КадроваяИсторияСотрудниковСрезПоследних.ФизическоеЛицо = &ФизическоеЛицо";
    
    Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицоСовмещающего);
    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();
    
    ДолжностьСовмещающего = "";
    ОтделСовмещающего = "";
    
    Если Выборка.Следующий() Тогда
        Если Выборка.Должность <> Неопределено Тогда
            ДолжностьСовмещающего = Выборка.Должность.Наименование;
        КонецЕсли;
        Если Выборка.Подразделение <> Неопределено Тогда
            ОтделСовмещающего = Выборка.Подразделение.Наименование;
        КонецЕсли;
    КонецЕсли;
    
    // Склонение должности совмещающего через словарь (Винительный падеж)
    СловарьДолж = СловарьДолжностей();
    КлючДляПоиска = СокрЛП(ДолжностьСовмещающего);
    ДолжностьСовмещающегоСклоненная = СловарьДолж.Получить(КлючДляПоиска);
    Если ДолжностьСовмещающегоСклоненная = Неопределено Тогда
        ДолжностьСовмещающегоСклоненная = ДолжностьСовмещающего;
    КонецЕсли;
    
    // === 3. Данные ОТСУТСТВУЮЩЕГО сотрудника (должность, отдел) ===
    СотрудникОтсутОбъект = СсылкаНаОтсутствующего.ПолучитьОбъект();
    ФизическоеЛицоОтсутствующего = СотрудникОтсутОбъект.ФизическоеЛицо;
    
    ЗапросОтсут = Новый Запрос;
    ЗапросОтсут.Текст = 
        "ВЫБРАТЬ
        |   КадроваяИсторияСотрудниковСрезПоследних.Должность КАК Должность,
        |   КадроваяИсторияСотрудниковСрезПоследних.Подразделение КАК Подразделение
        |ИЗ
        |   РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних КАК КадроваяИсторияСотрудниковСрезПоследних
        |ГДЕ
        |   КадроваяИсторияСотрудниковСрезПоследних.ФизическоеЛицо = &ФизическоеЛицо";
    
    ЗапросОтсут.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицоОтсутствующего);
    РезультатЗапросаОтсут = ЗапросОтсут.Выполнить();
    ВыборкаОтсут = РезультатЗапросаОтсут.Выбрать();
    
    ДолжностьОтсутствующего = "";
    ОтделОтсутствующего = "";
    
    Если ВыборкаОтсут.Следующий() Тогда
        Если ВыборкаОтсут.Должность <> Неопределено Тогда
            ДолжностьОтсутствующего = ВыборкаОтсут.Должность.Наименование;
        КонецЕсли;
        Если ВыборкаОтсут.Подразделение <> Неопределено Тогда
            ОтделОтсутствующего = ВыборкаОтсут.Подразделение.Наименование;
        КонецЕсли;
    КонецЕсли;
    
    // Склонение должности отсутствующего через словарь (Винительный падеж для Пункт1)
    КлючДляПоискаОтсут = СокрЛП(ДолжностьОтсутствующего);
    ДолжностьОтсутствующегоСклоненная = СловарьДолж.Получить(КлючДляПоискаОтсут);
    Если ДолжностьОтсутствующегоСклоненная = Неопределено Тогда
        ДолжностьОтсутствующегоСклоненная = ДолжностьОтсутствующего;
    КонецЕсли;

    // Склонение должности отсутствующего для родительного падежа (для Пункт2: "от оклада кого?")
    ДолжностьОтсутствующегоРодительный = СклонитьДолжностьВРодительныйПадеж(ДолжностьОтсутствующего);
    
    // === 4. Получение номера и даты трудового договора совмещающего ===
    НомерТрудовогоДоговора = "";
    ДатаТрудовогоДоговора = "";
    
    // Попытка 1: Через стандартный механизм кадровых данных
    Попытка
        КадровыеДанные = КадровыйУчет.КадровыеДанныеСотрудников(
            Ложь, 
            Новый Массив(СсылкаНаСовмещающего), 
            "ТрудовойДоговор", 
            Документ.Дата);
        
        Если КадровыеДанные.Количество() > 0 Тогда
            ТрудовойДоговор = КадровыеДанные[0].ТрудовойДоговор;
            Если ЗначениеЗаполнено(ТрудовойДоговор) Тогда
                НомерТрудовогоДоговора = ТрудовойДоговор.Номер;
                ДатаТрудовогоДоговора = Формат(ТрудовойДоговор.Дата, "ДФ='dd.MM.yyyy'");
            КонецЕсли;
        КонецЕсли;
    Исключение
        // Игнорируем ошибку, пробуем следующий способ
    КонецПопытки;
    
    // Попытка 2: Через прямой запрос к регистру (если первый способ не сработал)
    Если НЕ ЗначениеЗаполнено(НомерТрудовогоДоговора) Тогда
        Попытка
            ЗапросТД = Новый Запрос;
            ЗапросТД.Текст = 
                "ВЫБРАТЬ ПЕРВЫЕ 1
                |   ТрудовыеДоговорыРаботниковОрганизаций.Номер КАК НомерДоговора,
                |   ТрудовыеДоговорыРаботниковОрганизаций.Дата КАК ДатаДоговора
                |ИЗ
                |   РегистрСведений.ТрудовыеДоговорыРаботниковОрганизаций КАК ТрудовыеДоговорыРаботниковОрганизаций
                |ГДЕ
                |   ТрудовыеДоговорыРаботниковОрганизаций.Сотрудник = &Сотрудник
                |   И ТрудовыеДоговорыРаботниковОрганизаций.ДатаНачала <= &ДатаДокумента
                |УПОРЯДОЧИТЬ ПО
                |   ТрудовыеДоговорыРаботниковОрганизаций.ДатаНачала УБЫВ";
            
            ЗапросТД.УстановитьПараметр("Сотрудник", СсылкаНаСовмещающего);
            ЗапросТД.УстановитьПараметр("ДатаДокумента", Документ.Дата);
            
            РезультатТД = ЗапросТД.Выполнить();
            ВыборкаТД = РезультатТД.Выбрать();
            
            Если ВыборкаТД.Следующий() Тогда
                НомерТрудовогоДоговора = ВыборкаТД.НомерДоговора;
                ДатаТрудовогоДоговора = Формат(ВыборкаТД.ДатаДоговора, "ДФ='dd.MM.yyyy'");
            КонецЕсли;
        Исключение
            // Регистр не найден или другая ошибка - оставляем пустыми
        КонецПопытки;
    КонецЕсли;
    
    // === 5. Период совмещения ===
    ДатаНачала = Документ.ДатаНачала;
    ДатаОкончания = Документ.ДатаОкончания;
    
    Если ДатаНачала <> Неопределено И ДатаОкончания <> Неопределено Тогда
        ПериодСовмещения = "с " + Формат(ДатаНачала, "ДФ='dd MMMM yyyy'") + 
                          " года по " + Формат(ДатаОкончания, "ДФ='dd MMMM yyyy'") + " года";
    Иначе
        ПериодСовмещения = "";
    КонецЕсли;
    
    // === 6. Получаем ВСЕ области макета ===
    ОбластьМакетЛого = Макет.ПолучитьОбласть("Лого");
    ОбластьМакетЗаголовок = Макет.ПолучитьОбласть("Заголовок");
    ОбластьМакетПреамбула = Макет.ПолучитьОбласть("Преамбула");
    ОбластьМакетПункт1 = Макет.ПолучитьОбласть("Пункт1");
    ОбластьМакетПункт2 = Макет.ПолучитьОбласть("Пункт2");
    ОбластьМакетПункт3 = Макет.ПолучитьОбласть("Пункт3");
    ОбластьМакетПункт4 = Макет.ПолучитьОбласть("Пункт4");
    ОбластьМакетПодвал = Макет.ПолучитьОбласть("Подвал");
    ОбластьТабСогласо = Макет.ПолучитьОбласть("Согл");
    ОбластьТабОзнакомл = Макет.ПолучитьОбласть("ТабОзн");
    
    // === 7. Заполняем параметры ===
    ОбластьМакетЗаголовок.Параметры.ДатаДокумента = Формат(Документ.Дата, "ДФ='«dd» MMMM yyyyг.'");
    ОбластьМакетЗаголовок.Параметры.Номер = Документ.Номер;
    ОбластьМакетЗаголовок.Параметры.Город = "г. Сосногорск";
    
    ОбластьМакетПреамбула.Параметры.ОтсутствующийСотрудник = ФИООтсутствующего;
    
    // Пункт 1
    ОбластьМакетПункт1.Параметры.ДолжностьСовмещающего = ДолжностьСовмещающегоСклоненная;
    ОбластьМакетПункт1.Параметры.ОтделСовмещающего = ОтделСовмещающего;
    ОбластьМакетПункт1.Параметры.ФИОСовмещающего = ФИОСовмещающего;
    ОбластьМакетПункт1.Параметры.ПериодСовмещения = ПериодСовмещения;
	//ОбластьМакетПункт1.Параметры.ДатаТрудовогоДоговора = ДатаТрудовогоДоговора;
	//ОбластьМакетПункт1.Параметры.НомерТрудовогоДоговора = НомерТрудовогоДоговора;
    ОбластьМакетПункт1.Параметры.ДолжностьОтсутствующего = ДолжностьОтсутствующегоСклоненная; 
    ОбластьМакетПункт1.Параметры.ОтделОтсутствующего = ОтделОтсутствующего;
    
    // Пункт 2
    ОбластьМакетПункт2.Параметры.ФИОСовмещающего = ФИОСовмещающегоДательный;
    ОбластьМакетПункт2.Параметры.ДолжностьОтсутствующего = ДолжностьОтсутствующегоРодительный;
    
    // Генеральный директор
Если Документ.Руководитель <> Неопределено Тогда
    ОбластьМакетПодвал.Параметры.ГенДир = ПолучитьФИОСИнициаламиПослеФамилии(Документ.Руководитель.Наименование);
КонецЕсли;    
// Таблица ознакомления
ОбластьТабОзнакомл.Параметры.ДатаДокумента = Формат(Документ.Дата, "ДФ='dd.MM.yyyy'");
ОбластьТабОзнакомл.Параметры.Номер = Документ.Номер;
ОбластьТабОзнакомл.Параметры.ДолжностьСовмещающего = ДолжностьСовмещающего;    
ОбластьТабОзнакомл.Параметры.ФИОСовмещающего = ПолучитьФИОСИнициалами(ФИОСовмещающегоИсходное);

// Подвал - ФИО совмещающего в формате "Фамилия И. О."
ОбластьМакетПодвал.Параметры.ФИОСовмещающегоИнициалы = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ФизическоеЛицоСовмещающего);    // === 8. Выводим все области ===
    ТабДокумент.Вывести(ОбластьМакетЛого);
    ТабДокумент.Вывести(ОбластьМакетЗаголовок);
    ТабДокумент.Вывести(ОбластьМакетПреамбула);
    ТабДокумент.Вывести(ОбластьМакетПункт1);
    ТабДокумент.Вывести(ОбластьМакетПункт2);
    ТабДокумент.Вывести(ОбластьМакетПункт3);
    ТабДокумент.Вывести(ОбластьМакетПункт4);
    ТабДокумент.Вывести(ОбластьМакетПодвал);
    ТабДокумент.Вывести(ОбластьТабСогласо);
    ТабДокумент.Вывести(ОбластьТабОзнакомл);
    
    Возврат ТабДокумент;
    
КонецФункции         

// ============================================================================
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
// ============================================================================

// Упрощенная функция склонения ФИО
Функция СклонитьФИО(Знач ФИО, Падеж) Экспорт
    
    ФИО = СокрЛП(ФИО);
    Если ПустаяСтрока(ФИО) Тогда Возврат ""; КонецЕсли;
    
    Части = СтрРазделить(ФИО, " ", Ложь);
    Фамилия = Части[0];
    Имя = "";
    Отчество = "";
    
    Если Части.Количество() > 1 Тогда Имя = Части[1]; КонецЕсли;
    Если Части.Количество() > 2 Тогда Отчество = Части[2]; КонецЕсли;
    
    // --- СКЛОНЕНИЕ ФАМИЛИИ ---
    Если Прав(Фамилия, 3) = "ова" Или Прав(Фамилия, 3) = "ева" Или Прав(Фамилия, 3) = "ина" Тогда
        // Женские фамилии на -ова, -ева, -ина
        Если Падеж = "Родительный" Тогда Фамилия = Лев(Фамилия, СтрДлина(Фамилия)-1) + "ой";
        ИначеЕсли Падеж = "Дательный" Тогда Фамилия = Лев(Фамилия, СтрДлина(Фамилия)-1) + "ой";
        ИначеЕсли Падеж = "Винительный" Тогда Фамилия = Лев(Фамилия, СтрДлина(Фамилия)-1) + "у";
        КонецЕсли;
    ИначеЕсли Прав(Фамилия, 2) = "ов" Или Прав(Фамилия, 2) = "ев" Или Прав(Фамилия, 2) = "ин" Или Прав(Фамилия, 2) = "ын" Тогда
        // Мужские фамилии на -ов, -ев, -ин
        Если Падеж = "Родительный" Тогда Фамилия = Фамилия + "а";
        ИначеЕсли Падеж = "Дательный" Тогда Фамилия = Фамилия + "у";
        ИначеЕсли Падеж = "Винительный" Тогда Фамилия = Фамилия + "а";
        КонецЕсли;
    ИначеЕсли Прав(Фамилия, 2) = "ий" Или Прав(Фамилия, 2) = "ый" Тогда
        // Фамилии на -ий, -ый
        Если Падеж = "Родительный" Тогда Фамилия = Лев(Фамилия, СтрДлина(Фамилия)-2) + "ого";
        ИначеЕсли Падеж = "Дательный" Тогда Фамилия = Лев(Фамилия, СтрДлина(Фамилия)-2) + "ому";
        ИначеЕсли Падеж = "Винительный" Тогда Фамилия = Лев(Фамилия, СтрДлина(Фамилия)-2) + "ого";
        КонецЕсли;
    КонецЕсли;
    
    // --- СКЛОНЕНИЕ ИМЕНИ ---
    Если Прав(Имя, 1) = "а" Тогда
        Если Падеж = "Родительный" Тогда Имя = Лев(Имя, СтрДлина(Имя)-1) + "ы";
        ИначеЕсли Падеж = "Дательный" Тогда Имя = Лев(Имя, СтрДлина(Имя)-1) + "е";
        ИначеЕсли Падеж = "Винительный" Тогда Имя = Лев(Имя, СтрДлина(Имя)-1) + "у";
        КонецЕсли;
    ИначеЕсли Прав(Имя, 1) = "я" Тогда
        Если Падеж = "Родительный" Тогда Имя = Лев(Имя, СтрДлина(Имя)-1) + "и";
        ИначеЕсли Падеж = "Дательный" Тогда Имя = Лев(Имя, СтрДлина(Имя)-1) + "е";
        ИначеЕсли Падеж = "Винительный" Тогда Имя = Лев(Имя, СтрДлина(Имя)-1) + "ю";
        КонецЕсли;
    Иначе // Мужские имена на согласную
        Если Падеж = "Родительный" Тогда Имя = Имя + "а";
        ИначеЕсли Падеж = "Дательный" Тогда Имя = Имя + "у";
        ИначеЕсли Падеж = "Винительный" Тогда Имя = Имя + "а";
        КонецЕсли;
    КонецЕсли;
    
    // --- СКЛОНЕНИЕ ОТЧЕСТВА ---
    Если Прав(Отчество, 3) = "вич" Тогда
        Если Падеж = "Родительный" Тогда Отчество = Отчество + "а";
        ИначеЕсли Падеж = "Дательный" Тогда Отчество = Отчество + "у";
        ИначеЕсли Падеж = "Винительный" Тогда Отчество = Отчество + "а";
        КонецЕсли;
    ИначеЕсли Прав(Отчество, 3) = "вна" Тогда
        Если Падеж = "Родительный" Тогда Отчество = Лев(Отчество, СтрДлина(Отчество)-1) + "ы";
        ИначеЕсли Падеж = "Дательный" Тогда Отчество = Лев(Отчество, СтрДлина(Отчество)-1) + "е";
        ИначеЕсли Падеж = "Винительный" Тогда Отчество = Лев(Отчество, СтрДлина(Отчество)-1) + "у";
        КонецЕсли;
    КонецЕсли;
    
    // Собираем обратно
    Результат = Фамилия;
    Если Не ПустаяСтрока(Имя) Тогда Результат = Результат + " " + Имя; КонецЕсли;
    Если Не ПустаяСтрока(Отчество) Тогда Результат = Результат + " " + Отчество; КонецЕсли;
    
    Возврат Результат;
КонецФункции           

// Форматирует ФИО в вид "И. О. Фамилия"
Функция ПолучитьФИОСИнициалами(Знач ФИО) Экспорт
    
    ФИО = СокрЛП(ФИО);
    Если ПустаяСтрока(ФИО) Тогда Возврат ""; КонецЕсли;
    
    Части = СтрРазделить(ФИО, " ", Ложь);
    
    // Если ФИО неполное (нет отчества), возвращаем как есть
    Если Части.Количество() < 3 Тогда 
        Возврат ФИО; 
    КонецЕсли;
    
    Фамилия = Части[0];
    Имя = Части[1];
    Отчество = Части[2];
    
    Инициалы = Лев(Имя, 1) + ". " + Лев(Отчество, 1) + ". ";
    
    Возврат Инициалы + Фамилия;
    
КонецФункции

